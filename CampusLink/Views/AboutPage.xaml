<UserControl x:Class="CampusLink.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" HorizontalAlignment="Left">

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="92" Height="92" CornerRadius="22" Background="#10151F">
                        <Image Source="/Resources/app-icon-256.png" Width="88" Height="88" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{StaticResource StrongTextBrush}" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"
                                   Text="面向锐捷 SAM+ / eportal 门户（广州大学 222.201.54.55）的校园网认证客户端：登录、下线、保活、MAC 无感注册、多账号管理、断网自动重连与协议诊断。" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                                   Text="技术栈：WPF (.NET Framework 4.8) + WPF-UI (Fluent) + Newtonsoft.Json，账号密码用 Windows DPAPI 加密保存。" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="版本与更新" Style="{StaticResource SectionTitleStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="当前版本" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Update.CurrentVersionText}" FontSize="15"
                                       Foreground="{StaticResource StrongTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="最新版本" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Update.LatestVersionText}" FontSize="15"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Update.StatusText}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Update.SourceText}" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />

                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Update.Progress, Mode=OneWay}"
                                 Margin="0,10,0,0" Background="#1B2130" Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0"
                                 Visibility="{Binding Update.IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding Update.ProgressText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                               Visibility="{Binding Update.IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button Content="检查更新" Appearance="Primary" Command="{Binding Update.CheckCommand}"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="立即更新" Appearance="Caution" Command="{Binding Update.DownloadCommand}"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding Update.HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ui:Button Content="打开发布页" Appearance="Secondary"
                                   Command="{Binding Update.OpenReleaseCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="项目主页" Appearance="Transparent" Command="{Binding OpenProjectCommand}" />
                    </StackPanel>

                    <TextBlock Text="https://github.com/Thomas455/CampusLink" Style="{StaticResource MutedTextStyle}"
                               FontFamily="Consolas" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="关注作者" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="工具是业余写的，有问题或建议欢迎到这些地方找我。" />

                    <ItemsControl ItemsSource="{Binding Links}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="9" Background="#243044">
                                        <TextBlock Text="{Binding Badge}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   Foreground="{StaticResource StrongTextBrush}" />
                                        <TextBlock Text="{Binding Url}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <ui:Button Content="打开" Appearance="Secondary" Height="28" Padding="12,0"
                                                   FontSize="11" Margin="0,0,6,0"
                                                   Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Content="复制链接" Appearance="Transparent" Height="28" Padding="10,0"
                                                   FontSize="11"
                                                   Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="180" Height="180" CornerRadius="10" Background="White" Padding="6">
                        <Image Source="/Resources/sponsor.jpg" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="赞助支持" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="如果这个工具帮你省下了每次手动点门户的时间，可以扫码请我喝杯奶茶 ☕" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"
                                   Text="赞助完全自愿，不影响任何功能。" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="说明与免责" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="· 本工具只做协议层面的自动化：请求都以你自己的账号发出，请只用于你本人或已获授权管理的账号。" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                               Text="· 认证请求没有签名和 token，账号密码务必不要提交到公开仓库；本机保存的密码使用 DPAPI（当前用户）加密。" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                               Text="· 自助服务的验证码需要人工识别，「改密 / 查余额」等业务页面未做接口化，请在浏览器里操作。" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                               Text="· 生产环境行为（passwordEncrypt 真实取值、服务列表、验证码策略）以现场返回为准，可用「协议诊断」页核对。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="数据位置" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource MutedTextStyle}" FontFamily="Consolas" />
                    <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource MutedTextStyle}" FontFamily="Consolas"
                               Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="打开数据目录" Appearance="Secondary" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="打开日志目录" Appearance="Secondary" Command="{Binding OpenLogFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
