<UserControl x:Class="CampusLink.Views.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="370" />
        </Grid.ColumnDefinitions>

        <!-- 账号列表 -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                <ui:Button Content="添加账号" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddAccountCommand}" Margin="0,0,8,0" />
                <ui:Button Content="一键全部登录" Appearance="Secondary" Command="{Binding LoginAllCommand}" Margin="0,0,8,0" />
                <ui:Button Content="刷新全部状态" Appearance="Secondary" Command="{Binding ProbeAllCommand}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Accounts}"
                         SelectedItem="{Binding SelectedAccount}"
                         ItemContainerStyle="{StaticResource AccountListItemStyle}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource StrongTextBrush}" VerticalAlignment="Center" />
                                        <Border Background="{Binding StateColor}" CornerRadius="9" Padding="8,2"
                                                Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{Binding AutoFlags}" FontSize="11" Margin="10,0,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:Button Content="登录" Appearance="Primary" Height="30" Padding="10,0"
                                                   Command="{Binding LoginCommand}" Margin="0,0,6,0" />
                                        <ui:Button Content="下线" Appearance="Secondary" Height="30" Padding="10,0"
                                                   Command="{Binding LogoutCommand}" Margin="0,0,6,0" />
                                        <ui:Button Content="探测" Appearance="Secondary" Height="30" Padding="10,0"
                                                   Command="{Binding ProbeCommand}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource MutedTextStyle}"
                                           Margin="0,6,0,0" />

                                <TextBlock Grid.Row="2" Text="{Binding StateDetail}" FontSize="12"
                                           Foreground="{StaticResource StrongTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding MacText}" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SessionText}" FontSize="11" Margin="14,0,0,0"
                                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding LastCheckText}" FontSize="11" Margin="14,0,0,0"
                                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <ui:Button Content="编辑" Appearance="Secondary" Height="28" Padding="10,0"
                                               FontSize="11" Margin="0,0,6,0"
                                               Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="无感注册" Appearance="Secondary" Height="28" Padding="10,0"
                                               FontSize="11" Command="{Binding RegisterMacCommand}" Margin="0,0,6,0" />
                                    <ui:Button Content="解绑 MAC" Appearance="Secondary" Height="28" Padding="10,0"
                                               FontSize="11" Command="{Binding CancelMacCommand}" Margin="0,0,6,0" />
                                    <ui:Button Content="在线信息" Appearance="Secondary" Height="28" Padding="10,0"
                                               FontSize="11" Command="{Binding RefreshOnlineInfoCommand}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Margin="4,16,0,0" VerticalAlignment="Top" FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="还没有账号。点「添加账号」填写学号、密码并选择网卡。">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Accounts.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- 右侧：未打开编辑器时显示提示 -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch"
                Visibility="{Binding IsEditorClosed, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="账号配置" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Style="{StaticResource MutedTextStyle}"
                           Text="点左上角「添加账号」新建；要修改已有账号，点卡片上的「编辑」。" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"
                           Text="每个账号绑定一块网卡：认证用的 MAC 和源 IP 都取自该网卡，不需要手填 MAC。" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"
                           Text="密码用 Windows DPAPI 加密保存在本机，换电脑或换用户无法解密。" />

                <Separator Margin="0,16,0,12" />

                <TextBlock Text="快捷入口" Style="{StaticResource SectionTitleStyle}" />
                <ui:Button Content="打开数据目录" Appearance="Secondary" HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Left" Margin="0,0,0,8"
                           Command="{Binding OpenDataFolderCommand}" />
                <ui:Button Content="打开日志目录" Appearance="Secondary" HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Left"
                           Command="{Binding OpenLogFolderCommand}" />
            </StackPanel>
        </Border>

        <!-- 右侧：编辑/新增表单 -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock Text="显示名称（可选）" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Text="{Binding EditorDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="例如：宿舍主号" />

                        <TextBlock Text="学号 / 用户名" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Text="{Binding EditorUserId, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="例如：2023123456" />

                        <TextBlock Text="密码" Style="{StaticResource FieldLabelStyle}" />
                        <PasswordBox x:Name="AccountPasswordBox" Style="{StaticResource AppPasswordBoxStyle}"
                                     PasswordChanged="AccountPasswordBox_OnPasswordChanged" />
                        <TextBlock Text="{Binding EditorPasswordHint}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="认证网卡（决定 MAC 与源 IP）" Style="{StaticResource FieldLabelStyle}" />
                            <ui:Button Grid.Column="1" Content="刷新" Appearance="Transparent" Height="22" Padding="8,0"
                                       FontSize="11" Margin="0,6,0,0" Command="{Binding RefreshAdaptersCommand}" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding Adapters}"
                                  SelectedItem="{Binding SelectedAdapter}"
                                  DisplayMemberPath="DisplayName"
                                  Height="34" />
                        <TextBlock Text="{Binding AdapterHint}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />

                        <TextBlock Text="服务名（可选）" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Text="{Binding EditorService, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="getServices 返回的 serviceName，一般留空" />

                        <TextBlock Text="门户地址" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Text="{Binding EditorPortalHost, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="222.201.54.55" />

                        <TextBlock Text="备注" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Text="{Binding EditorRemark, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Margin="0,12,0,0">
                            <CheckBox Content="启动时自动登录" IsChecked="{Binding EditorAutoLogin}"
                                      Foreground="{StaticResource StrongTextBrush}" Margin="0,0,0,8" />
                            <CheckBox Content="掉线时自动重连" IsChecked="{Binding EditorAutoReconnect}"
                                      Foreground="{StaticResource StrongTextBrush}" Margin="0,0,0,8" />
                            <CheckBox Content="登录成功后自动注册 MAC 无感" IsChecked="{Binding EditorAutoRegisterMac}"
                                      Foreground="{StaticResource StrongTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock Text="{Binding EditorError}" Foreground="{StaticResource BadBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding EditorHint}" Foreground="{StaticResource GoodBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="保存" Appearance="Primary" Command="{Binding SaveAccountCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="取消" Appearance="Secondary" Command="{Binding CancelEditCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="删除账号" Appearance="Danger" Command="{Binding DeleteAccountCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="强制下线全部" Appearance="Caution" Command="{Binding ForceLogoutCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
