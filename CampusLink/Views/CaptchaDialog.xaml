<Window x:Class="CampusLink.Views.CaptchaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="输入验证码" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1B2130" Foreground="#E8EEF9"
        FontFamily="{StaticResource AppFont}">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Text="登录" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12" Foreground="#93A1B8" />
        <Border Background="#10151F" CornerRadius="6" Height="84" Margin="0,12,0,0"
                BorderBrush="#2A3346" BorderThickness="1">
            <Image x:Name="CaptchaImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="请输入图片中的验证码" FontSize="12" Foreground="#93A1B8" Margin="0,12,0,4" />
        <ui:TextBox x:Name="CodeBox" MaxLength="8" Height="34" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="取消" Appearance="Secondary" Click="Cancel_OnClick" Margin="0,0,8,0" />
            <ui:Button Content="确定" Appearance="Primary" Click="Ok_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
