<UserControl x:Class="CampusLink.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="协议诊断" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Style="{StaticResource MutedTextStyle}"
                           Text="按顺序调用门户接口，把原始响应打出来。排查「queryString 无效 / 密码错误 / 需要验证码」时，先看这里的返回。" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="当前账号：" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AccountHeader}" FontSize="12"
                               Foreground="{StaticResource StrongTextBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <WrapPanel Margin="0,12,0,0">
                    <ui:Button Content="1. 探测 queryString" Appearance="Primary" Command="{Binding ProbeCommand}" Margin="0,0,8,8" />
                    <ui:Button Content="2. pageInfo" Appearance="Secondary" Command="{Binding PageInfoCommand}" Margin="0,0,8,8" />
                    <ui:Button Content="3. 登录页字段 / RSA" Appearance="Secondary" Command="{Binding LoginPageCommand}" Margin="0,0,8,8" />
                    <ui:Button Content="4. getServices" Appearance="Secondary" Command="{Binding ServicesCommand}" Margin="0,0,8,8" />
                    <ui:Button Content="5. getOnlineUserInfo" Appearance="Secondary" Command="{Binding OnlineInfoCommand}" Margin="0,0,8,8" />
                    <ui:Button Content="复制结果" Appearance="Transparent" Command="{Binding CopyCommand}" Margin="0,0,8,8" />
                    <ui:Button Content="清空" Appearance="Transparent" Command="{Binding ClearCommand}" Margin="0,0,8,8" />
                </WrapPanel>

                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBox Text="{Binding Output, Mode=OneWay}"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"
                     Background="#0E1320" Foreground="#C9D6EA"
                     BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                     Padding="10" />
        </Grid>
    </Grid>
</UserControl>
