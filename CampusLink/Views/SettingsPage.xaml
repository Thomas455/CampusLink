<UserControl x:Class="CampusLink.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

            <!-- 学校预设 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="学校预设" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="不同学校门户地址不同。一个预设对应配置目录里的一个 json 文件，可导出给同学、也可导入别人分享的预设。" />

                    <ComboBox ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset}"
                              DisplayMemberPath="DisplayName"
                              Height="34" Margin="0,10,0,0" />

                    <WrapPanel Margin="0,10,0,0">
                        <ui:Button Content="新建" Appearance="Secondary" Command="{Binding NewPresetCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="保存修改" Appearance="Primary" Command="{Binding SavePresetCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="设为当前" Appearance="Secondary" Command="{Binding ActivatePresetCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="删除" Appearance="Danger" Command="{Binding DeletePresetCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="导入" Appearance="Secondary" Command="{Binding ImportPresetCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="导出" Appearance="Secondary" Command="{Binding ExportPresetCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="打开预设目录" Appearance="Transparent" Command="{Binding OpenPresetFolderCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ActivePresetHint}" FontSize="12"
                               Foreground="{StaticResource GoodBrush}" Margin="0,0,0,4" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="学校名称" Style="{StaticResource FieldLabelStyle}" />
                            <ui:TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="例如：广州大学·大学城校区" />
                            <TextBlock Text="门户地址" Style="{StaticResource FieldLabelStyle}" />
                            <ui:TextBox Text="{Binding PresetPortalHost, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="例如：222.201.54.55" />
                            <TextBlock Text="默认密码模板（{uid} 会替换成学号）" Style="{StaticResource FieldLabelStyle}" />
                            <ui:TextBox Text="{Binding PresetPasswordTemplate, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{}{uid}@Gzhu" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="预设作者" Style="{StaticResource FieldLabelStyle}" />
                            <ui:TextBox Text="{Binding PresetAuthor, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="例如：Thomas455" />
                            <TextBlock Text="自助服务地址" Style="{StaticResource FieldLabelStyle}" />
                            <ui:TextBox Text="{Binding PresetSelfServiceUrl, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="http://222.201.54.23:8080/selfservice" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"
                                       Text="新建账号时会自动带出当前预设的门户地址；「账号信息」页的「自助服务」按钮也用这里的地址。" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 协议 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="门户与协议" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="探测地址（每行一个，按顺序尝试）" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding ProbeUrls, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="86" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" Padding="8"
                             Background="#141A26" Foreground="{StaticResource StrongTextBrush}"
                             BorderBrush="{StaticResource CardBorderBrush}"
                             FontFamily="Consolas" FontSize="12" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="密码加密模式" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding PasswordEncryptModes}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedPasswordEncryptMode}"
                                      Height="34" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                                       Text="先保持「自动」，登录报密码错误再试强制明文 / RSA。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="RSA 拼接分隔符" Style="{StaticResource FieldLabelStyle}" />
                            <ui:TextBox Text="{Binding RsaSeparator, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="自动化" Style="{StaticResource SectionTitleStyle}" />
                    <CheckBox Content="启动时自动登录（按账号里的设置）" IsChecked="{Binding AutoLoginOnStartup}"
                              Foreground="{StaticResource StrongTextBrush}" Margin="0,4,0,8" />
                    <CheckBox Content="启用掉线自动重连" IsChecked="{Binding AutoReconnectEnabled}"
                              Foreground="{StaticResource StrongTextBrush}" Margin="0,0,0,8" />
                    <CheckBox Content="启用会话保活（按 keepaliveInterval）" IsChecked="{Binding KeepaliveEnabled}"
                              Foreground="{StaticResource StrongTextBrush}" Margin="0,0,0,8" />

                    <TextBlock Text="自动重连检查间隔（秒）" Style="{StaticResource FieldLabelStyle}" />
                    <ui:TextBox Width="140" HorizontalAlignment="Left"
                                Text="{Binding ReconnectCheckSeconds, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="窗口与启动" Style="{StaticResource SectionTitleStyle}" />
                    <CheckBox Content="开机自动启动" IsChecked="{Binding StartWithWindows}"
                              Foreground="{StaticResource StrongTextBrush}" Margin="0,4,0,8" />
                    <CheckBox Content="关闭窗口时最小化到托盘" IsChecked="{Binding CloseToTray}"
                              Foreground="{StaticResource StrongTextBrush}" Margin="0,0,0,8" />
                    <CheckBox Content="最小化时隐藏到托盘" IsChecked="{Binding MinimizeToTray}"
                              Foreground="{StaticResource StrongTextBrush}" Margin="0,0,0,8" />
                    <CheckBox Content="显示托盘气泡通知" IsChecked="{Binding ShowBalloonNotifications}"
                              Foreground="{StaticResource StrongTextBrush}" />

                    <Border Background="#10151F" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="看不到托盘图标？" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource StrongTextBrush}" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                                       Text="Windows 11 默认把新图标收进任务栏的「^ 隐藏的图标」里。打开「任务栏设置 → 其他系统托盘图标 → CampusLink」即可让它常驻显示。" />
                            <ui:Button Content="打开任务栏设置" Appearance="Secondary" HorizontalAlignment="Left"
                                       Margin="0,8,0,0" Command="{Binding OpenTaskbarSettingsCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="更新" Style="{StaticResource SectionTitleStyle}" />
                    <CheckBox Content="启动时自动检查更新（GitCode / GitHub）" IsChecked="{Binding CheckUpdateOnStartup}"
                              Foreground="{StaticResource StrongTextBrush}" Margin="0,4,0,8" />
                    <TextBlock Text="自动检查的最小间隔（小时）" Style="{StaticResource FieldLabelStyle}" />
                    <ui:TextBox Width="140" HorizontalAlignment="Left"
                                Text="{Binding UpdateCheckIntervalHours, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"
                               Text="手动检查更新与下载进度在「关于」页；仓库地址：github.com/Thomas455/CampusLink" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="数据位置" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource MutedTextStyle}"
                               FontFamily="Consolas" />
                    <TextBlock Text="{Binding PresetsDirectory}" Style="{StaticResource MutedTextStyle}"
                               FontFamily="Consolas" Margin="0,2,0,0" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"
                               Text="账号密码用 Windows DPAPI（当前用户）加密保存，换机器或换用户无法解密。" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center">
                <ui:Button Content="保存设置" Appearance="Primary" Command="{Binding SaveCommand}" />
                <TextBlock Text="预设的保存 / 导入 / 导出是独立按钮，勾选项改完点这里保存" Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
