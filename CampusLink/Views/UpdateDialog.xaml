<ui:FluentWindow x:Class="CampusLink.Views.UpdateDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="CampusLink 更新" Width="660" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 Background="{StaticResource PageBackgroundBrush}" Foreground="{StaticResource StrongTextBrush}"
                 FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="CampusLink 更新" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="22,0,22,20">
            <TextBlock Text="检查更新" Style="{StaticResource SectionTitleStyle}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="当前版本" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding CurrentVersionText}" FontSize="15"
                               Foreground="{StaticResource StrongTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="最新版本" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding LatestVersionText}" FontSize="15"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" />

            <Border Background="#0F1420" CornerRadius="8" Padding="12" Margin="0,10,0,0"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource StrongTextBrush}" />
                </ScrollViewer>
            </Border>

            <TextBlock Text="{Binding AssetName}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" />

            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                         Margin="0,12,0,0" Background="#1B2130" Foreground="{StaticResource AccentBrush}"
                         BorderThickness="0"
                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                       Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="立即更新" Appearance="Primary" Command="{Binding DownloadCommand}"
                           Margin="0,0,8,0"
                           Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ui:Button Content="打开发布页" Appearance="Secondary" Command="{Binding OpenReleaseCommand}"
                           Margin="0,0,8,0" />
                <ui:Button Content="关闭" Appearance="Transparent" Click="Close_OnClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
